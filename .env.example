# Groq Cloud API Key (Get it from console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (Recommended: openai/gpt-oss-120b or qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b

# Apify Personal API Token (Get it from console.apify.com Account Settings -> Integrations)
# Optional: If omitted, the app will run in fallback simulation mode for Amazon product links
APIFY_API_TOKEN=your_apify_api_token_here
